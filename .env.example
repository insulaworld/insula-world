# Copy this file to .env and fill in what you need. Lines starting with # are ignored.

# Your Anthropic API key, for AI brains. Leave empty for rule-based brains.
ANTHROPIC_API_KEY=

# Which model the agents use.
# LLM_MODEL=claude-haiku-5-5

# Model prices in dollars per million tokens, for the cost report printed every 10 minutes
# (and shown at http://localhost:3000/api/usage). These are Haiku 5.5's prices for prompts under 100k tokens.
LLM_PRICE_IN=0.10
LLM_PRICE_OUT=0.50

# Solana RPC. Leave empty for public devnet. For mainnet, use a paid RPC (for example Helius).
# RPC_URL=

# Length of one island day in milliseconds. Leave empty for real 24-hour days.
# 60000 = one day per minute (for testing and filming).
# INSULA_DAY_MS=

# Where the world is saved. Use a different file for tests.
# INSULA_SAVE=data/world.json

# Set to 1 to start a brand-new world (ignores the save).
# INSULA_FRESH=

# Web server port.
# PORT=3000
